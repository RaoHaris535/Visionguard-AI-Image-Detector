# Application
APP_ENV=production
SECRET_KEY=replace-with-a-random-value
MAX_UPLOAD_MB=8
MODEL_PATH=/app/models/champion.keras
MODEL_VERSION=unregistered
DECISION_THRESHOLD=0.50

# Local UI: local loads MODEL_PATH; remote calls INFERENCE_API_URL
INFERENCE_MODE=local
INFERENCE_API_URL=http://inference-api:8080
INFERENCE_API_KEY=replace-with-a-separate-random-value

# PostgreSQL (Compose keeps the database port private)
POSTGRES_DB=visionguard
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=replace-with-a-random-value
DATABASE_URL=postgresql+psycopg://visionguard:replace-with-a-random-value@db:5432/visionguard

# DagsHub and MLflow - values belong only in .env, never in source control
MLFLOW_TRACKING_URI=https://dagshub.com/OWNER/REPOSITORY.mlflow
MLFLOW_TRACKING_USERNAME=OWNER
MLFLOW_TRACKING_PASSWORD=replace-with-a-revocable-token
DAGSHUB_USER_TOKEN=replace-with-a-revocable-token
